---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "SelarasKerja — Kerja inklusif dimulai dari informasi yang jelas",
  description = "SelarasKerja mempertemukan pencari kerja dengan lowongan yang memahami kebutuhan akomodasi mereka.",
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1226aa" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
