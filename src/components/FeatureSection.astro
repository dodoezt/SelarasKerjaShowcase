---
import { features } from "../data/showcase";
---

<section class="features slide" id="fitur">
  <div class="section-index">03 / FITUR UNGGULAN</div>
  <div class="feature-heading">
    <div>
      <p class="eyebrow">DARI PROFIL SAMPAI LAMARAN</p>
      <h2>Dirancang untuk<br /><em>dua sisi.</em></h2>
    </div>
    <p>
      Satu alur yang membantu pencari kerja menemukan tempat yang sesuai dan perusahaan menyampaikan dukungan yang tersedia.
    </p>
  </div>

  <div class="feature-list">
    {features.map((feature, index) => (
      <div class="feature-row">
        <span class="feature-no">0{index + 1}</span>
        <h3>{feature}</h3>
        <span class="feature-arrow" aria-hidden="true">↗</span>
      </div>
    ))}
  </div>

  <div class="feature-photo">
    <img src="/img/carrusel-1.webp" alt="Cerita tentang kesempatan kerja dan inklusi" />
    <div>
      <span>FOKUS PADA KECOCOKAN</span>
      <strong>Bukan sekadar<br />mencari lowongan.</strong>
    </div>
  </div>
</section>
